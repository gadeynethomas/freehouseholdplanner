{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FHP Probe",
  "version": "0.1.0",
  "identifier": "org.freehouseholdplanner.probe",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "FHP Probe", "width": 420, "height": 800 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
